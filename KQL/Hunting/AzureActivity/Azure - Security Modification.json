{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "workspace": {
            "type": "String"
        }
    },
    "resources": [
        {
            "id": "[concat(resourceId('Microsoft.OperationalInsights/workspaces/providers', parameters('workspace'), 'Microsoft.SecurityInsights'),'/alertRules/dc6c0cbd-abeb-4259-8d1d-fcbbf846d614')]",
            "name": "[concat(parameters('workspace'),'/Microsoft.SecurityInsights/dc6c0cbd-abeb-4259-8d1d-fcbbf846d614')]",
            "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
            "kind": "Scheduled",
            "apiVersion": "2023-12-01-preview",
            "properties": {
                "displayName": "Azure - Security Modification",
                "description": "Detects when a user modify an Azure resource",
                "severity": "Medium",
                "enabled": true,
                "query": "AzureActivity\r\n| where ingestion_time() > ago(5m)\r\n| where OperationNameValue in~ ('MICROSOFT.NETWORK/BASTIONHOSTS/CREATESHAREABLELINKS/ACTION','Microsoft.Security/threatDetectionPolicies/write')\r\n| where ActivityStatusValue startswith 'Succe'\r\n| extend name=case(OperationNameValue =~ 'Microsoft.Security/threatDetectionPolicies/write','Threat Policy Modification',OperationNameValue =~  'MICROSOFT.NETWORK/BASTIONHOSTS/CREATESHAREABLELINKS/ACTION','Bastion Shareable Link Created',OperationNameValue startswith \"MICROSOFT.NETWORK\" and (OperationNameValue endswith \"STARTPACKETCAPTURE/ACTION\" or OperationNameValue endswith \"PACKETCAPTURES/WRITE\"),'Network Packet Capture Enabled','')\r\n| extend d=coalesce(ResourceId,_ResourceId),spriv=Authorization_d.evidence.role\r\n| extend Description=strcat(Caller,case(OperationNameValue =~ 'Microsoft.Security/threatDetectionPolicies/write',' modified database threat detection policy  ',OperationNameValue =~  'MICROSOFT.NETWORK/BASTIONHOSTS/CREATESHAREABLELINKS/ACTION',' created Bastion shareable link ',OperationNameValue startswith \"MICROSOFT.NETWORK\" and (OperationNameValue endswith \"STARTPACKETCAPTURE/ACTION\" or OperationNameValue endswith \"PACKETCAPTURES/WRITE\"),' enabled network packet capture',''),' from ',CallerIpAddress,' on ',ResourceId)",
                "queryFrequency": "PT5M",
                "queryPeriod": "PT7M",
                "triggerOperator": "GreaterThan",
                "triggerThreshold": 0,
                "suppressionDuration": "PT5H",
                "suppressionEnabled": false,
                "startTimeUtc": null,
                "tactics": [
                    "DefenseEvasion",
                    "InitialAccess",
                    "LateralMovement"
                ],
                "techniques": [
                    "T1562",
                    "T1133",
                    "T1021"
                ],
                "subTechniques": [
                    "T1562.001",
                    "T1021.001",
                    "T1021.004"
                ],
                "alertRuleTemplateName": null,
                "incidentConfiguration": {
                    "createIncident": true,
                    "groupingConfiguration": {
                        "enabled": true,
                        "reopenClosedIncident": false,
                        "lookbackDuration": "PT5H",
                        "matchingMethod": "Selected",
                        "groupByEntities": [
                            "Account"
                        ],
                        "groupByAlertDetails": [],
                        "groupByCustomDetails": []
                    }
                },
                "eventGroupingSettings": {
                    "aggregationKind": "SingleAlert"
                },
                "alertDetailsOverride": {
                    "alertDisplayNameFormat": "Azure - {{name}}",
                    "alertDescriptionFormat": "{{Description}}",
                    "alertDynamicProperties": []
                },
                "customDetails": {},
                "entityMappings": [
                    {
                        "entityType": "Account",
                        "fieldMappings": [
                            {
                                "identifier": "FullName",
                                "columnName": "Caller"
                            }
                        ]
                    },
                    {
                        "entityType": "IP",
                        "fieldMappings": [
                            {
                                "identifier": "Address",
                                "columnName": "CallerIpAddress"
                            }
                        ]
                    }
                ],
                "sentinelEntitiesMappings": null,
                "templateVersion": null
            }
        }
    ]
}